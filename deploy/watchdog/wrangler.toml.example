# ipig-watchdog — 外部看門狗（跑在 Cloudflare，不在 prod 筆電上）
#
# 這是**樣板**，本檔進版控。實際部署用的 wrangler.toml 由本檔複製而來
# （`cp wrangler.toml.example wrangler.toml`），.gitignore 已排除，不進版控——
# R104 最小揭露原則：ALERT_TO / destination_address / KV namespace id 是
# 本機才填的真實值，不寫回這份樣板。
# ⚠️ 禁止在任一份檔案寫入 token / 密碼 / API key。
#    PING_TOKEN 走 `wrangler secret put`，不是 [vars]。
#
# 部署前必須替換的 <佔位符> 見 README.md §2。

name = "ipig-watchdog"
main = "src/worker.js"
compatibility_date = "2026-01-01"

# 每 5 分鐘探測一次；連續 FAIL_THRESHOLD 次失敗才告警（預設 3 = 15 分鐘）
[triggers]
crons = ["*/5 * * * *"]

[vars]
HEALTH_URL = "https://ipigsystem.asia/api/health"
FAIL_THRESHOLD = "3"
PROBE_TIMEOUT_MS = "10000"
# 寄件地址必須屬於本 zone；收件地址必須已在 Cloudflare Email Routing 驗證過
# 🔗 這個值與檔案末端 [[send_email]] 的 allowed_sender_addresses **必須一致**，見該處說明。
ALERT_FROM = "watchdog@ipigsystem.asia"
ALERT_TO = "<已在 Email Routing 驗證的收件信箱>"

# 狀態儲存（連續失敗計數、已告警旗標、各 job 最後心跳時間）
[[kv_namespaces]]
binding = "WATCHDOG_KV"
id = "<wrangler kv namespace create WATCHDOG_KV 產生的 id>"

# Cloudflare Email Routing 的 send_email binding：
# destination_address 限定單一已驗證地址，Worker 無法拿它寄給任意人；
# allowed_sender_addresses 限定寄件地址只能是 ALERT_FROM，收窄最小權限
#
# 🔴 **這裡的兩個值分別與上面 [vars] 的 ALERT_FROM／ALERT_TO 重複維護，wrangler 的 toml
#    不支援變數插值，只能靠人同步。** 這個重複的代價不對稱，所以值得一條明文規則：
#      · 改了 ALERT_FROM 卻忘了同步 allowed_sender_addresses
#        → Email Routing 直接拒收，`send_email` binding 在 runtime 丟錯，
#          **看門狗的告警信從此全部寄不出去，而它自己不會告訴你**（唯一的徵兆是
#          Cloudflare Dashboard 上該次 cron 標記失敗，見 README §6）。
#      · 改了 ALERT_TO 卻忘了同步 destination_address → 同上。
#    也就是說：這個檔案裡打錯一個字，會讓「監控」這件事整個安靜地消失。
#    改動任一邊時，把另一邊一起改，並依 README §5 的失敗演練實際收一封信確認。
#    （Qodo 於 2026-08-11 merge main 後的追蹤 review 抓到；原始三輪 review 未提及。）
[[send_email]]
name = "ALERT_EMAIL"
destination_address = "<同 ALERT_TO>"
# ⚠️ 必須與 [vars] 的 ALERT_FROM 逐字相同
allowed_sender_addresses = ["watchdog@ipigsystem.asia"]
