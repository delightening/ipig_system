# R30-3a Outbox Worker — independent container image.
#
# Mirrors backend Dockerfile build pipeline (cargo-chef + distroless), but only
# builds the `outbox_worker` binary and ships with a different CMD.
#
# Why separate image (vs. shared with backend + CMD override)?
# - Independent deploy / scale: backend rolling update won't touch worker
# - Smaller blast radius: worker OOM / restart can't affect HTTP traffic
# - Multiple replicas safe: claim_batch uses FOR UPDATE SKIP LOCKED

# Stage 1: Chef
FROM lukemathwalker/cargo-chef:latest-rust-1.97 AS chef
WORKDIR /app

# Stage 2: Planner
FROM chef AS planner

COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Builder
FROM chef AS builder

# 限制 cargo 並行度（與 backend/Dockerfile 一致）：本機 prod 在筆電 WSL2（6 vCPU）內 build，
# 滿載會把 CPU 推到 93°C、M.2 SSD 撞 SMART 溫控跳點（56°C）。預設 4 對 CI（ubuntu-latest = 4 vCPU）
# 無損；本機 6→4 壓尖峰。設在 builder 開頭，涵蓋下方 `cargo chef cook` 與 `cargo build`。
# 覆寫：docker build --build-arg CARGO_BUILD_JOBS=N。
ARG CARGO_BUILD_JOBS=4
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=planner /app/recipe.json recipe.json
ENV SQLX_OFFLINE=true
RUN bash -c 'set -o pipefail; cargo chef cook --release --recipe-path recipe.json 2>&1 | (grep -vE "warning:.*(edition is set on|unused manifest key:)" || true)'

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY migrations ./migrations
COPY .sqlx ./.sqlx
COPY resources ./resources
COPY build.rs ./build.rs

ARG GIT_SHA=""
ARG BUILD_TIME=""
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIME=${BUILD_TIME}

RUN cargo build --release --bin outbox_worker

# Stage 4: Runtime — minimal Debian for user setup
FROM debian:bookworm-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false appuser && \
    mkdir -p /app && \
    chown -R appuser:appuser /app

COPY --from=builder /app/target/release/outbox_worker /app/outbox_worker

# Stage 5: Distroless — production image
FROM gcr.io/distroless/cc-debian12

WORKDIR /app

COPY --from=runtime /etc/passwd /etc/passwd
COPY --from=runtime /etc/group /etc/group
COPY --from=runtime /app /app
COPY --from=runtime /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

USER appuser

ENV RUST_LOG=info

# 無 HTTP 端口；不暴露 EXPOSE 也不裝 healthcheck（worker 透過 DB metrics 監控）

CMD ["./outbox_worker"]
