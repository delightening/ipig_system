# ============================================================
# iPig System 環境變數設定範本
# ============================================================
# 複製此檔案為 .env 並填入正式值
#   cp .env.example .env
#
# ⚠️ 請勿將 .env 加入版本控制
#
# 何者放 .env、何者放 DB（system_settings）請見：
#   docs/operations/ENV_AND_DB.md
# ============================================================

# =========================
# 伺服器
# =========================
# 後端監聽位址
HOST=0.0.0.0
# 後端監聽埠號
PORT=3000

# =========================
# PostgreSQL 資料庫
# =========================
# 資料庫使用者名稱
POSTGRES_USER=postgres
# 資料庫密碼（⚠️ 必須修改為強密碼）
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
# 資料庫名稱
POSTGRES_DB=ipig_db
# 對外映射的 PostgreSQL 埠號（host 端，5432 為 PostgreSQL 預設，5433 常用於本機避開衝突）
POSTGRES_PORT=5433

# 【必填】後端連接資料庫的 URL
# 格式: postgres://<user>:<password>@<host>:<port>/<db>
# Docker 內部使用 service name 'db'；本機開發可改 localhost
DATABASE_URL=postgres://postgres:CHANGE_THIS_PASSWORD@db:5432/ipig_db
# 編譯時若無資料庫：設為 true 使用 .sqlx 快取（backend/.cargo/config.toml 已預設）
# SQLX_OFFLINE=true
# 連線池最大連線數
DATABASE_MAX_CONNECTIONS=10
# 連線池最小連線數（預熱）
# DATABASE_MIN_CONNECTIONS=5
# 取得連線逾時秒數
# DATABASE_ACQUIRE_TIMEOUT_SECONDS=30
# 個別 SQL 查詢執行上限（毫秒）；0 = 停用（開發期間可設 0，生產建議 30000）
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# 連線失敗重試次數
DATABASE_RETRY_ATTEMPTS=5
# 每次重試間隔（秒）
DATABASE_RETRY_DELAY_SECONDS=5

# =========================
# JWT 認證（ES256 非對稱金鑰）
# =========================
# 【必填】EC P-256 私鑰 PEM（用於簽發 JWT）
# 產生方式（只需執行一次，妥善保存私鑰！）:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt > secrets/jwt_ec_private_key.pem
#   openssl ec -in secrets/jwt_ec_private_key.pem -pubout > secrets/jwt_ec_public_key.pem
#
# 方式一：直接指定 PEM 檔案路徑（推薦 Docker Secrets）
JWT_EC_PRIVATE_KEY_FILE=./secrets/jwt_ec_private_key.pem
JWT_EC_PUBLIC_KEY_FILE=./secrets/jwt_ec_public_key.pem
#
# 方式二：直接設定 PEM 內容（本機開發快速使用）
# JWT_EC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_EC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Access Token 有效期（分鐘）
# 預設 15 分鐘，符合 NIST AAL2 醫療敏感系統建議；必須 < AUTH_IDLE_TIMEOUT_MINUTES。
# 縮短可降低 token 失竊後 blast radius；前端 silent refresh 自動處理過期，使用者無感。
JWT_EXPIRATION_MINUTES=15

# Refresh Token 有效期（天數）
JWT_REFRESH_EXPIRATION_DAYS=7
# 每位使用者同時可擁有的最大活躍 Session 數量
MAX_SESSIONS_PER_USER=5

# R41-1: 閒置 session 強制 revoke 的閾值（分鐘）
# Refresh 時若 refresh_token.last_used_at 距今 > 此值即拒絕，使用者需重新登入。
# 對齊 NICS 附表十普級「存取控制 / 帳號管理」閒置鎖定要求。
# 預設 600 分鐘 (10h)；緊急時可調 1440 = 24h 暫時停用。
AUTH_IDLE_TIMEOUT_MINUTES=600

# =========================
# 帳號鎖定（SEC-20 登入失敗鎖定）
# =========================
# 關閉帳號鎖定（true=關閉，開發環境適用；正式環境請保持 false）
DISABLE_ACCOUNT_LOCKOUT=false
# 鎖定前允許的登入失敗次數（預設 5）
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
# 鎖定時間（分鐘），此時間內失敗次數達上限即鎖定（預設 30，對齊 constants.rs 與 PASSWORD_POLICY.md）
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# R37-2 完成 (2026-05-09)：管理員初始密碼改用 secret file 模式
# 不要在 .env 直接設值。建立 `secrets/admin_initial_password.txt`，內容為強密碼。
# compose 已設 ADMIN_INITIAL_PASSWORD_FILE=/run/secrets/admin_initial_password。
# 完整流程見 docs/runbooks/secrets-management.md §3 Step 5。
# 本機／E2E：可設 ADMIN_INITIAL_PASSWORD=admin123（fallback 路徑），
#   並用下方指令同步 DB 內 admin 密碼：
#   docker compose run --rm api /app/create_admin
# ADMIN_INITIAL_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# =========================
# 稽核日誌完整性（SEC-34）
# =========================
# HMAC-SHA256 密鑰，用於稽核日誌防篡改雜湊鏈。
#
# ⚠️ 硬性要求：
#   - config.rs 檢查字串長度 ≥ 44 chars（對應 base64 編碼的 32 bytes 原始值，
#     等同 HMAC-SHA256 完整密鑰強度 256 bits；NIST SP 800-107 建議）
#   - 必須與 JWT_EC_PRIVATE_KEY 不同（洩漏一邊不能推另一邊）
#   - ⚠️ 一旦寫入 audit row，**密鑰永不可更換**（會讓既有 row 無法驗證
#     integrity_hash）；僅能隨 migration 加 new column 搭配版本化路線
#
# R37-1 完成 (2026-05-09)：HMAC key 改用 secret file 模式
# 不要在 .env 直接設值。建立 `secrets/audit_hmac_key.txt`：
#   openssl rand -base64 32 | tr -d '\n' > secrets/audit_hmac_key.txt   # Linux/macOS
# compose 已設 AUDIT_HMAC_KEY_FILE=/run/secrets/audit_hmac_key。
# 完整流程見 docs/runbooks/secrets-management.md §3 Step 2。
# AUDIT_HMAC_KEY=CHANGE_THIS_TO_RANDOM_BASE64_32BYTES_MINIMUM

# R66-B2/C6: app 層 AEAD at-rest 加密金鑰（XChaCha20-Poly1305，32 bytes base64）
#   - 用途：加密 TOTP secret（2FA）/ 簽章 bridge payload at-rest
#   - 必須與 JWT_EC_PRIVATE_KEY / AUDIT_HMAC_KEY 皆不同（金鑰隔離、blast-radius）
#   - ⚠️ 一旦加密資料，更換金鑰前須先解密／重加密既有 row（信封帶 key_version
#     支援未來輪替）；遺失金鑰 → 既有 2FA secret 無法解密、使用者須重設 2FA
#   - 未設定時 2FA「啟用」會被拒絕（fail-closed）；既有 legacy 明文 row 讀取不受影響
# 建立 secret file（勿在 .env 直接設值）：
#   openssl rand -base64 32 | tr -d '\n' > secrets/encryption_key.txt   # Linux/macOS
# compose 設 ENCRYPTION_KEY_FILE=/run/secrets/encryption_key。部署後跑：
#   cargo run --bin backfill_totp_encryption   # 加密既有明文 TOTP secret
# ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_BASE64_32BYTES

# R26-2 audit chain 每日驗證 cron 啟用旗標（預設 false）
# - false：cron job 已排程但 verify_yesterday_chain() 立即早退
# - true：每日 02:00 UTC 驗證昨日 user_activity_logs HMAC chain；斷鏈時
#         INSERT security_alerts 並透過 SecurityNotifier::dispatch 發送告警
# Ops 啟用前置條件（按順序）：
#   1. migration 037 已上線（user_activity_logs.hmac_version 欄位存在）
#   2. R26-6 已完成（verifier 支援 legacy v=1 / canonical v=2 分流）
#   3. 在 staging/test 環境驗證 cron 連續執行 ≥7 天無 false positive
# 設為 true 後即可啟用 GLP 21 CFR Part 11 §11.10「Secure - 不可竄改」自動驗證
AUDIT_CHAIN_VERIFY_ACTIVE=false

# R30-27：role / permission 變更強制電子簽章（密碼 + 手寫雙因子）。
# 預設 false（R30-27a backend ship 階段）：service 已準備好接受簽章 payload，
# 但仍允許舊流程改 role / permission（admin UI 沒有簽章 dialog 之前不卡死）。
# R30-27b 前端 dialog 完成、production 切換 true 後正式 enforce
# 21 CFR §11.10(d)「限制系統存取的人事改動需 authority check + 簽章」。
# 啟用前置條件：(1) 前端 RoleEditDialog 加密碼 + handwriting canvas
#               (2) 用 R30-27c 手機 bridge 解決桌機滑鼠簽名困難問題
ROLE_SIGNATURE_REQUIRED=false

# =========================
# 電子郵件（SMTP）— 服務 #1 Backend
# =========================
# 【Plan B：4 個服務各自獨立 app password，互不共用】
# 詳見 docs/operations/SMTP_CREDENTIALS.md
#
# 以下為「預設／備援」：後台「系統設定」存進 DB 後會覆蓋 .env，無須重啟即可更換 SMTP。
# SMTP 伺服器位址（留空則停用郵件功能）
SMTP_HOST=smtp.gmail.com
# SMTP 埠號
SMTP_PORT=587
# SMTP 使用者名稱（Gmail 服務帳號，例：alerts@example.com）
SMTP_USERNAME=your-service-account@gmail.com
# ⚠️ Backend 的 SMTP 密碼改用 Docker secret 檔案，不要在這裡寫明文
#    檔案位置：./secrets/smtp_password.txt
#    本機 dev 若要以 env 測試，可暫時取消下一行註解：
# SMTP_PASSWORD=CHANGE_THIS_SMTP_PASSWORD
# 寄件者信箱（建議與 SMTP_USERNAME 相同）
SMTP_FROM_EMAIL=your-service-account@gmail.com
# 寄件者顯示名稱
SMTP_FROM_NAME=iPig System

# =========================
# 應用程式
# =========================
# 前端 URL（用於郵件中的連結）
APP_URL=https://your-domain.example.com
# 前端 Nginx 對外埠號
WEB_PORT=8080
# 檔案上傳儲存路徑
UPLOAD_DIR=./uploads

# =========================
# PDF Service (print-pdf)
# =========================
# FastAPI + Chromium/Playwright 單一 PDF 服務 (取代 gotenberg + pdf-service)
# 註：2026-06 起引擎已由 WeasyPrint 改為 Chromium，見 services/print-pdf/README.md
PDF_SERVICE_URL=http://print-pdf:9200
# R37-6 完成 (2026-05-09)：內部服務認證 token 改用 secret file
# 不要在 .env 直接設值。建立 `secrets/pdf_service_token.txt`：
#   openssl rand -hex 32 | tr -d '\n' > secrets/pdf_service_token.txt
# compose 已設 PDF_SERVICE_TOKEN_FILE=/run/secrets/pdf_service_token（api + pdf-service 兩端讀同一個檔）。
# PDF_SERVICE_TOKEN=change-me-pdf-service-token

# =========================
# 打卡地理圍籬
# =========================
# 允許打卡的 IP 範圍（CIDR 格式，逗號分隔可設定多組）
# 範例: 10.0.0.0/24,192.168.1.0/24
ALLOWED_CLOCK_IP_RANGES=

# 辦公室 GPS 座標（緯度）
CLOCK_OFFICE_LATITUDE=25.000000
# 辦公室 GPS 座標（經度）
CLOCK_OFFICE_LONGITUDE=121.000000
# GPS 允許半徑（公尺）
CLOCK_GPS_RADIUS_METERS=200

# =========================
# 安全設定
# =========================
# Cookie Secure 旗標
#   true  = 僅 HTTPS 傳送 cookie（生產環境）
#   false = 允許 HTTP（開發環境）
COOKIE_SECURE=false
# Cookie 所屬網域（選用，未設定則使用 request host）
# 範例: .your-domain.example.com
# COOKIE_DOMAIN=

# 是否載入開發測試用帳號
#   true  = 啟動時自動建立測試帳號（開發環境）
#   false = 不建立（生產環境）
SEED_DEV_USERS=true

# 是否信任反向代理的 IP header（X-Forwarded-For、X-Real-IP）
#   true  = 使用 proxy header 中的 IP（有 Nginx/Cloudflare 前端時）
#   false = 僅使用 socket 直連 IP
TRUST_PROXY_HEADERS=true

# CORS 允許的 Origin（逗號分隔）
# 範例: http://localhost:8080,https://your-domain.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8080

# =========================
# 整合測試（僅開發/CI 使用）
# =========================
# 測試用資料庫 URL（CI 或本機跑整合測試時使用，未設則沿用 DATABASE_URL）
# TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/ipig_db_test
# TEST_ADMIN_EMAIL=admin@example.com
# TEST_ADMIN_PASSWORD=your_test_password
# TEST_USER_PASSWORD=your_test_user_password

# =========================
# E2E 測試（Playwright）
# =========================
# 建立測試帳號: cargo run --bin create_test_user <email> <password> <name>
# E2E_BASE_URL=http://localhost:8080
# E2E_USER_EMAIL=e2e-test@ipig.local
# E2E_USER_PASSWORD=your_e2e_password
# E2E_ADMIN_EMAIL=admin@ipigsystem.asia
# E2E_ADMIN_PASSWORD=your_admin_password

# =========================
# 日誌格式
# =========================
# 設為 json 時啟用 JSON 結構化日誌（適合搭配 ELK/Loki）
# 預設（留空或不設定）: 人眼可讀的文字格式
RUST_LOG_FORMAT=

# =========================
# 備份設定
# =========================
# 備份排程（cron 格式，預設每天凌晨 2:00）
BACKUP_SCHEDULE=0 2 * * *
# 備份保留天數
BACKUP_RETENTION_DAYS=30
# 容器啟動時立即跑一次（dev / debug 用，prod 建議 false 等 cron 觸發）
BACKUP_ON_START=false

# --- GPG 加密 ---
# Prod 必須 true（強制加密），dev 可 false
BACKUP_REQUIRE_ENCRYPTION=true
# 加密收件者（Key ID 或 email），需與 secrets/backup_gpg_pubkey.asc 內公鑰對應
# 步驟詳見 docs/runbooks/backup-gpg-setup.md：
#   1) gpg --full-generate-key（dedicated backup keypair，不要用個人 key）
#   2) gpg --export -a <recipient> > secrets/backup_gpg_pubkey.asc
#   3) 私鑰用 gpg --export-secret-key 匯出後離線存兩份（USB + paper key）
#   4) 重啟 db-backup 容器（entrypoint 會自動 import secrets/ 內的公鑰）
# 範例: BACKUP_GPG_RECIPIENT=backup@ipig.example.com
BACKUP_GPG_RECIPIENT=

# --- 異地備份（R36-5/6/7 rclone dual remote）---
# ?拐辣?脣?嚗3 ?詨捆嚗? NAS SMB share ??remote
# 設定步驟詳見 docs/runbooks/backup-setup.md
# 留空則跳過異地上傳（僅本機 docker volume 保留）
BACKUP_RCLONE_REMOTES=
# 範例: BACKUP_RCLONE_REMOTES=r2:your-bucket-name,nas:your-shared-folder

# --- 過時：rsync over SSH（已棄用，改用 rclone）---
RSYNC_TARGET=

# =========================
# Prometheus /metrics 端點保護
# =========================
# Bearer Token 保護 /metrics 端點（留空則無認證，僅適合 Docker 內網環境）
# 設定後須同步寫入 secrets/metrics_token.txt（Prometheus 從該檔案讀取）
# 產生方式: openssl rand -hex 32
METRICS_TOKEN=

# =========================
# 監控（Prometheus + Grafana + Alertmanager）
# =========================
# 監控已整合於 base docker-compose.yml（隨主 stack 啟動）
# Grafana 管理員帳號
GRAFANA_ADMIN_USER=admin
# R37-3 完成 (2026-05-09)：Grafana admin 密碼改用 secret file
# 不要在 .env 直接設值。建立 `secrets/grafana_admin_password.txt` 內容為 16+ 字元強密碼。
# compose 已設 GF_SECURITY_ADMIN_PASSWORD__FILE（Grafana 原生雙底線語法）。
# 注意：升級舊 deployment 時，Grafana sqlite 已存舊密碼 → env var 不會覆蓋，需手動：
#   docker exec ipig-grafana sh -c 'grafana cli admin reset-admin-password "$(cat /run/secrets/grafana_admin_password)"'
# GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# -------------------------
# 服務 #3 Grafana SMTP（Alert 發信用）
# -------------------------
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_USER=your-service-account@gmail.com
# ⚠️ Plan B: Grafana 密碼改用 Docker secret 檔案
#    檔案位置：./secrets/grafana_smtp_password.txt
#    Grafana 原生支援 GF_SMTP_PASSWORD__FILE 自動讀取

# -------------------------
# 服務 #2 Alertmanager
# -------------------------
# Webhook URL（如 Slack、Teams、自訂 API）
ALERTMANAGER_WEBHOOK_URL=
# R37-7 完成 (2026-05-09)：Alertmanager → api webhook token 改用 secret file
# 不要在 .env 直接設值。建立 `secrets/alertmanager_webhook_token.txt`：
#   openssl rand -hex 32 | tr -d '\n' > secrets/alertmanager_webhook_token.txt
# compose 已設 ALERTMANAGER_WEBHOOK_TOKEN_FILE=/run/secrets/alertmanager_webhook_token。
# config.rs:367 改用 read_secret() 優先讀檔，沒檔回退 env。
# ALERTMANAGER_WEBHOOK_TOKEN=
# Email 通知（critical 等級）
ALERT_EMAIL_TO=your-alert-inbox@example.com
ALERT_EMAIL_FROM=your-service-account@gmail.com
ALERT_SMTP_HOST=smtp.gmail.com:587
ALERT_SMTP_USER=your-service-account@gmail.com
# ⚠️ Plan B: Alertmanager 密碼改用 Docker secret 檔案
#    檔案位置：./secrets/alert_smtp_password.txt
#    docker-entrypoint.sh 在 env 未提供時會自動從該檔載入

# =========================
# GeoIP（選用）
# =========================
# MaxMind License Key（用於自動更新 GeoLite2-City）
# 取得方式: https://www.maxmind.com/en/accounts/current/license-key
MAXMIND_LICENSE_KEY=
# GeoLite2-City.mmdb 檔案路徑
GEOIP_DB_PATH=/app/geoip/GeoLite2-City.mmdb

# =========================
# Container Registry (GHCR) — 正式環境
# =========================
# GitHub 使用者或組織名稱（用於 image path）
# GHCR_OWNER=your-github-username
# 部署的 image tag（預設 latest，回滾時可指定 commit SHA）
# IMAGE_TAG=latest

# =========================
# Watchtower 自動更新 — 正式環境
# =========================
# API token（手動觸發更新用，產生方式: openssl rand -hex 32）
# WATCHTOWER_API_TOKEN=
# 部署通知信箱
# DEPLOY_NOTIFY_EMAIL=admin@example.com
